import pytest
from backend.nodes import ASTParserNode

def test_extract_tree_structure_with_valid_python_returns_structure():
    """
    Happy Path: Verify that the parser correctly extracts 
    class, function, and import signatures.
    """
    parser = ASTParserNode()
    # Setup: Create a dummy legacy file
    with open("test_sample.py", "w") as f:
        f.write("import os\n\nclass DiskScheduler:\n    def scan(self):\n        pass")
    
    result = parser.extract_tree("test_sample.py")
    
    # Assertions
    assert "DiskScheduler" in result
    assert "scan" in result
    assert "os" in result

def test_extract_tree_with_syntax_error_returns_parsing_error():
    """
    Robustness Path: Verify that the parser handles broken code 
    gracefully by returning the specific PARSING_ERROR status.
    """
    parser = ASTParserNode()
    with open("broken.py", "w") as f:
        f.write("def invalid_syntax(self: ...") # Deliberately incomplete
        
    result = parser.extract_tree("broken.py")
    assert "PARSING_ERROR" in result